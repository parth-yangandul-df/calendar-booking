# Database
ConnectionStrings__DefaultConnection=Server=localhost;Database=CalendarBookingDb;User Id=sa;Password=YOUR_DB_PASSWORD;TrustServerCertificate=True;

# Google Calendar API OAuth2
GoogleCalendar__OAuth2__ClientId=YOUR_GOOGLE_CLIENT_ID
GoogleCalendar__OAuth2__ClientSecret=YOUR_GOOGLE_CLIENT_SECRET
GoogleCalendar__OAuth2__RefreshToken=YOUR_GOOGLE_REFRESH_TOKEN

# Optional: Calendar ID override (defaults to primary calendar)
GoogleCalendar__CalendarId=

# SMTP / Email
Email__Host=sandbox.smtp.mailtrap.io
Email__Port=2525
Email__Username=YOUR_SMTP_USERNAME
Email__Password=YOUR_SMTP_PASSWORD
Email__FromAddress=noreply@calbooking.com
Email__FromName=Calendar Booking
