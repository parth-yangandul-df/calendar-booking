# =============================================================================
# Calendar Booking System — Environment Variables
# =============================================================================
# Copy to .env and fill in your values. These override appsettings.json.
# ASP.NET Core reads env vars with __ (double underscore) for nested keys.
# =============================================================================

# --- Database ---
ConnectionStrings__DefaultConnection="Server=localhost;Database=CalendarBookingDb;User Id=sa;Password=CHANGE_ME;TrustServerCertificate=True;"

# --- JWT ---
Jwt__Key="CHANGE_ME_min_32_characters_long_jwt_signing_key"

# --- Admin Seed ---
AdminSeed__Email="admin@calbooking.com"
AdminSeed__Password="CHANGE_ME"

# --- Google Calendar (for Meet links) ---
GoogleCalendar__CalendarId=""
GoogleCalendar__OAuth2__ClientId="CHANGE_ME"
GoogleCalendar__OAuth2__ClientSecret="CHANGE_ME"
GoogleCalendar__OAuth2__RefreshToken="CHANGE_ME"

# --- SMTP / Email ---
Email__Host="CHANGE_ME"
Email__Port=587
Email__Username="CHANGE_ME"
Email__Password="CHANGE_ME"
Email__FromAddress="noreply@calbooking.com"
Email__FromName="Calendar Booking"
